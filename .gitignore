# See https://git-scm.com/docs/gitignore

# ── Secrets & credentials (never commit) ───────────────────────────────────
.env
.env.*
!.env.example
*.env
*token.json*
*credentials.json*
credentials.json
.credentials
*firebase-adminsdk*.json
*.pem
*.key

# ── OS / editors ───────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Node / JS ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.next/
out/
next-env.d.ts
.vercel
.cache/
build/
dist/
coverage/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
test_venv/
test_env/
test_uv/
.pytest_cache/
.mypy_cache/
.coverage
backend/coverage_html/
.ipynb_checkpoints/

# ── Logs & local data ──────────────────────────────────────────────────────
*.log
dump.rdb
backend/data/
backend/uploads/
mobile-consultant/uploads/
agenthub/agents/youtube/db

# ── Test artifacts ─────────────────────────────────────────────────────────
playwright/test-results/
playwright/artifacts/
playwright/playwright-report/

# ── Large local assets (kept on disk, not in git) ──────────────────────────
Icons File/
Image1\ /
destination-illustrations/*
!destination-illustrations/manifest.json

# ── Archives & binaries ────────────────────────────────────────────────────
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# ── Tooling leftovers ──────────────────────────────────────────────────────
chainlit.md
.chainlit
.ac
.kilo/
.emergent/
android-sdk/
