# --- Required ---
MONGO_URL=mongodb://user:pass@host:27017/wehive
REACT_APP_BACKEND_URL=https://api.yourdomain.com

# --- Optional ---
DB_NAME=wehive
JWT_SECRET=change_me
JWT_ALG=HS256
OTP_CHANNEL=mock
MOCK_OTP_CODE=123456

# --- Admin ---
ADMIN_EMAILS=admin@example.com
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=strongpassword
ADMIN_SEED_NAME=Super Admin

# --- Frontend (for admin emails) ---
FRONTEND_URL=https://yourdomain.com

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=We Hive

# --- Twilio (SMS/WhatsApp OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- AI / LLM ---
EMERGENT_LLM_KEY=

# Default LLM provider (fallback when user has no personal AI Marketplace config)
# Set DEFAULT_LLM_KEY and Eva works out of the box for all authenticated users.
# Free options: Groq (gsk_...) at console.groq.com, OpenRouter (sk-or-...)
# DEFAULT_LLM_PROVIDER=groq
# DEFAULT_LLM_KEY=gsk_your_key_here
# DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# --- Ollama (local LLM + embeddings) ---
# Ollama runs at http://localhost:11434 by default. Install from https://ollama.com
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- RAG / Vector Store ---
# CHROMA_PATH=./data/chroma
# RAG_DEFAULT_COLLECTION=wehive_rag
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120

# --- Local Prompts ---
# PROMPTS_DIR=./prompts
# PROMPTS_DEFAULT_VERSION=1

# --- Firebase Auth (Frontend) ---
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# --- Firebase Auth (Backend) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account"}

# --- Telegram (Messaging/Auth) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=

# --- Discord (Notifications) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# --- WhatsApp Community ---
WHATSAPP_GROUP_INVITE_LINK=https://chat.whatsapp.com/your-invite-code

# --- Razorpay (Payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
