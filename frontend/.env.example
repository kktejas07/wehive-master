# WeHive frontend (CRA/craco) environment variables. Copy to frontend/.env.
# Only REACT_APP_* vars are exposed to the browser -- never put secrets here.

# Backend API base URL (no trailing slash; the app appends /api)
REACT_APP_BACKEND_URL=http://localhost:8000

# Firebase web app config (public client config, not a secret)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Analytics (optional)
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# Community links (optional)
REACT_APP_COMMUNITY_PHONE_NUMBER=
REACT_APP_COMMUNITY_TELEGRAM_LINK=
REACT_APP_COMMUNITY_WHATSAPP_LINK=

# Sherpa travel-requirements widget (optional)
REACT_APP_SHERPA_API_KEY=
