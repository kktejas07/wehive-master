USVISA_CHECK_INTERVAL=

# ── Third-party data APIs ───────────────────────────────────────────────────
VISA_HQ_API_KEY=
VISA_HQ_BASE_URL=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=
SCORECARD_API_KEY=
UNIVERSITY_API_BASE=
N8N_BASE_URL=
N8N_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
CONSULTANT_NAME=
CONSULTANT_AUTO_REPLY=

# ── Offline seed/enrichment scripts only (seed_*.py, enrich_*.py) ───────────
MONGODB_URI=
MONGODB_DB=

# ── Ad-hoc deploy scripts (ssh_deploy.py, sync_*.py; see deploy_ssh_common.py)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_SSH_KEY=~/.ssh/id_ed25519   # preferred over DEPLOY_PASSWORD
DEPLOY_PASSWORD=
DEPLOY_KNOWN_HOSTS=~/.ssh/known_hosts
DEPLOY_BACKEND_ROOT=
DEPLOY_FRONTEND_ROOT=

# ---- Tests (live-server suites only) ----
TEST_ADMIN_PASSWORD=
TEST_ADMIN_OLD_PASSWORD=
RATE_LIMIT_DISABLED=        # set to 1 only for a local test server
