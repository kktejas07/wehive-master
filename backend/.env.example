# WeHive backend environment variables (names only; placeholder values).
# Copy to backend/.env (loaded by backend/server.py) and fill in real values.
# NEVER commit real secrets. Frontend vars live in frontend/.env.example.

# ── Core ────────────────────────────────────────────────────────────────────
APP_ENV=development            # development | test | production
MONGO_URL=mongodb://localhost:27017
DB_NAME=wehive
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=

# ── Auth / JWT / OTP ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRES_HOURS=720
RESET_TOKEN_TTL_MINUTES=30
OTP_CHANNEL=
OTP_TTL_MINUTES=10
OTP_EXPIRY_MINUTES=
OTP_LENGTH=
OTP_RESEND_COOLDOWN_SECONDS=
MOCK_OTP_CODE=                 # dev/test only; leave empty in production
BYOK_VAULT_SECRET=

# ── Admin bootstrap ─────────────────────────────────────────────────────────
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
ADMIN_SEEDS_JSON=

# ── Firebase Admin (backend) ────────────────────────────────────────────────
# FIREBASE_CREDENTIALS is the full service-account JSON as a single-line string
# (falls back to the `settings.firebase` document in MongoDB if unset).
# Do not commit the *firebase-adminsdk*.json key file.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# ── Email (SMTP / Postal) ───────────────────────────────────────────────────
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
POSTAL_API_URL=
POSTAL_API_KEY=
POSTAL_FROM=
POSTAL_FROM_NAME=

# ── SMS / WhatsApp / Telegram / Discord ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_INSTANCE_ID=
WHATSAPP_VISA_NUMBER=
WHATSAPP_GROUP_INVITE_LINK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_VISA_CHANNEL=
TELEGRAM_B1B2_GROUP=
TELEGRAM_F1_GROUP=
TELEGRAM_H1B_GROUP=
TELEGRAM_SLOT_CHANNELS=
DISCORD_WEBHOOK_URL=

# ── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_BYPASS_ENABLED=false   # true only for local/mock mode

# ── Storage (Cloudflare R2) ─────────────────────────────────────────────────
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_SIGNED_URL_TTL=

# ── LLM providers / AI marketplace ──────────────────────────────────────────
DEFAULT_LLM_PROVIDER=
DEFAULT_LLM_KEY=
DEFAULT_LLM_MODEL=
DAILY_FREE_TOKENS_PER_USER=
HIVE_MODEL=
# Any of these enable the corresponding fallback provider (ai_marketplace.py):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
REPLICATE_API_TOKEN=
DEEPINFRA_API_KEY=
NOVITA_API_KEY=
AI21_API_KEY=
MOONSHOT_API_KEY=
CLOUDFLARE_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_API_KEY=
UPSTAGE_API_KEY=
SHUTTLEAI_API_KEY=
CLARIFAI_API_KEY=
TOGETHER_API_KEY=
TOGETHER_URL=
TOGETHER_IMAGE_MODEL=
STABILITY_API_KEY=

# ── Ollama / RAG / prompts ──────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_TIMEOUT=
CHROMA_PATH=
RAG_DEFAULT_COLLECTION=
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
PROMPTS_DIR=
PROMPTS_DEFAULT_VERSION=
KG_CACHE_TTL=

# ── Research agent (STARK) & search ─────────────────────────────────────────
STARK_ENABLED=
STARK_TIMEOUT=
STARK_CACHE_TTL=
STARK_MAX_SOURCES=
STARK_ARXIV=
STARK_BRAVE=
STARK_DDG=
STARK_GEMINI_RESEARCH=
STARK_GITHUB=
STARK_GOOGLE_AI=
STARK_KAGI=
STARK_KNOWLEDGE=
STARK_PYPI=
STARK_SEARXNG=
STARK_SERPER=
STARK_WIKIPEDIA=
BRAVE_SEARCH_API_KEY=
KAGI_API_KEY=
SERPER_API_KEY=
SEARXNG_BASE_URL=
GOOGLE_CX=
GITHUB_TOKEN=

# ── Self-learning / aggregators / schedulers ────────────────────────────────
HIVE_SELF_LEARN=
HIVE_SELF_LEARN_DAYS=
HIVE_SELF_LEARN_FORCE=
HIVE_SELF_LEARN_MIN_DELTA=
HIVE_SELF_LEARN_MIN_FEEDS=
AGGREGATOR_AUTO_APPROVE=
